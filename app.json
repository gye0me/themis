{
  "expo": {
    "name": "themis",
    "slug": "themis",
    "scheme": "themis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "증거로 남길 음성을 녹음하기 위해 마이크 접근 권한이 필요합니다."
        }
      ]
    ],
    "android": {
      "permissions": ["RECORD_AUDIO"]
    }
  }
}

{
  "expo": {
    "name": "themis",
    "slug": "themis",
    "scheme": "themis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.themis.app"
    },
    "plugins": [
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "증거로 남길 음성을 녹음하기 위해 마이크 접근 권한이 필요합니다."
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#1E3A5F"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.themis.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3ca3d694-e15f-4d3a-ac11-d4e1871ed6fa"
      }
    },
    "owner": "hdeid"
  }
}

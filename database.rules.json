{
  "rules": {
    "chatRooms": {
      "$roomId": {
        "messages": {
          ".read": "auth != null",
          "$messageId": {
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid) && (newData.child('senderId').val() === auth.uid)"
          }
        },
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || ($roomId.beginsWith('dm-') && $roomId.contains(auth.uid)))"
          }
        }
      }
    },
    "roomRequests": {
      ".read": "auth != null",
      "$topicKey": {
        "topic": {
          ".write": "auth != null"
        },
        "openedRoomId": {
          ".write": "auth != null"
        },
        "interested": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "openedRoomsIndex": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    },
    "userDmRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomId": {
          ".write": "auth != null && $roomId.contains(auth.uid)"
        }
      }
    }
  }
}
